<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ResellWise ALL Engine | Integrated Aggregator</title>
    <style>
        :root {
            --bg: #0b0f19;
            --surface: #151c2c;
            --surface-card: #1e293b;
            --primary: #6366f1;
            --accent-cyan: #06b6d4;
            --accent-green: #10b981;
            --accent-purple: #a855f7;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --border: #334155;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', system-ui, sans-serif; }
        body { background-color: var(--bg); color: var(--text-main); min-height: 100vh; padding-bottom: 50px; }

        header {
            background: rgba(21, 28, 44, 0.95); backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border); padding: 18px 5%;
            position: sticky; top: 0; z-index: 100;
            display: flex; justify-content: space-between; align-items: center;
        }

        .brand-badge {
            background: linear-gradient(135deg, var(--primary), var(--accent-cyan));
            color: #000; font-weight: 900; padding: 6px 14px; border-radius: 8px; font-size: 18px;
        }

        .hub-back-btn {
            background: rgba(255,255,255,0.08); border: 1px solid var(--border);
            color: var(--text-main); padding: 8px 16px; border-radius: 8px;
            text-decoration: none; font-size: 13px; font-weight: 700; transition: all 0.2s;
        }
        .hub-back-btn:hover { background: var(--primary); color: #fff; }

        .container { max-width: 1300px; margin: 30px auto; padding: 0 20px; }

        .search-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 16px; padding: 25px; margin-bottom: 30px;
        }

        .search-row { display: flex; gap: 12px; margin-bottom: 20px; }
        .search-row input {
            flex: 1; padding: 16px 20px; background: #0f172a;
            border: 1px solid var(--border); border-radius: 10px; color: white; font-size: 16px; outline: none;
        }
        .search-row input:focus { border-color: var(--primary); }

        .btn { padding: 16px 22px; border: none; border-radius: 10px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
        .btn-primary { background: linear-gradient(135deg, var(--primary), #4f46e5); color: white; }
        .btn-cyan { background: linear-gradient(135deg, var(--accent-cyan), #0891b2); color: #000; }
        .btn-purple { background: linear-gradient(135deg, var(--accent-purple), #7c3aed); color: white; }

        .category-filter { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 15px; padding-top: 15px; border-top: 1px solid var(--border); }
        .cat-chip {
            background: #0f172a; border: 1px solid var(--border); padding: 8px 16px;
            border-radius: 20px; font-size: 13px; cursor: pointer; color: var(--text-muted); transition: all 0.2s;
        }
        .cat-chip.active, .cat-chip:hover { background: var(--primary); color: white; border-color: var(--primary); font-weight: 700; }

        .grid-results { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin-top: 20px; }
        .card-item {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 14px; padding: 20px; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;
        }
        .card-item:hover { transform: translateY(-3px); border-color: var(--primary); }

        .platform-tag {
            font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 4px 10px;
            border-radius: 6px; letter-spacing: 0.5px; margin-bottom: 12px; display: inline-block; width: fit-content;
        }

        .tag-general { background: rgba(99, 102, 241, 0.2); color: #818cf8; border: 1px solid #6366f1; }
        .tag-ev { background: rgba(6, 182, 212, 0.2); color: #22d3ee; border: 1px solid #06b6d4; }
        .tag-tech { background: rgba(16, 185, 129, 0.2); color: #34d399; border: 1px solid #10b981; }

        .btn-card { display: block; text-align: center; padding: 10px; border-radius: 8px; text-decoration: none; background: var(--surface-card); border: 1px solid var(--border); color: white; font-weight: 700; margin-top: 15px; }
        .btn-card:hover { background: var(--accent-green); color: #000; border-color: var(--accent-green); }
    </style>
</head>
<body>

    <header>
        <div style="display: flex; align-items: center; gap: 12px;">
            <span class="brand-badge">ALL ENGINE</span>
            <div style="font-size: 20px; font-weight: 700;">Resell<span style="color:var(--primary);">Wise</span> Combined Engine</div>
        </div>
        <a href="all_hub_engine.html" class="hub-back-btn">⬅ Povratak na ALL HUB</a>
    </header>

    <div class="container">
        <div class="search-card">
            <div class="search-row">
                <input type="text" id="allSearchInput" placeholder="Pretraži bilokoji predmet ili EV vehicle (npr. Tesla Model 3, iPhone 14, Wallbox 22kW)..." value="Tesla Model 3">
                <button class="btn btn-primary" onclick="runAllEngine()">🔍 Pretraži Sve</button>
                <button class="btn btn-cyan" onclick="openAllTabs()">🌐 Otvori Sve Kartice</button>
                <button class="btn btn-purple" onclick="runAIAnalysis()">✨ AI Procjena</button>
            </div>

            <div class="category-filter">
                <div class="cat-chip active" onclick="filterCategory('all', this)">🌐 Svi Izvori</div>
                <div class="cat-chip" onclick="filterCategory('ev', this)">⚡ EV Vozila & Oprema</div>
                <div class="cat-chip" onclick="filterCategory('general', this)">🛒 General E-Commerce</div>
                <div class="cat-chip" onclick="filterCategory('tech', this)">💻 Tech & Refurbished</div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
            <h2 id="resultsHeading" style="font-size: 20px;">Rezultati Integrirane Pretrage</h2>
            <span id="resultsCount" style="color: var(--text-muted); font-size: 14px;"></span>
        </div>

        <div id="resultsGrid" class="grid-results"></div>
    </div>

    <script>
        // INTEGRATED PLATFORM REGISTRY (General + EV + Tech)
        const combinedPlatforms = [
            // EV Platforms
            { id: 'mobile_de', name: 'Mobile.de EV', cat: 'ev', tagClass: 'tag-ev', icon: '🚗', url: (q) => `https://www.mobile.de/srp/search?isSearchRequest=true&vc=Car&ft=ELECTRICITY&q=${q}`, desc: 'EU Tržnica Električnih Vozila' },
            { id: 'autoscout24', name: 'AutoScout24 EV', cat: 'ev', tagClass: 'tag-ev', icon: '🚗', url: (q) => `https://www.autoscout24.com/lst?atype=C&ustate=N%2CU&fuel=E&sort=standard&desc=0&query=${q}`, desc: 'Širom EU Ponuda EV-a' },
            { id: 'ebay_motors', name: 'eBay Motors EV & Baterije', cat: 'ev', tagClass: 'tag-ev', icon: '⚙️', url: (q) => `https://www.ebay.com/b/Auto-Parts-and-Vehicles/6000/bn_1865334?_nkw=${q}+electric`, desc: 'EV Baterije, dijelovi i punjači' },
            
            // General Platforms
            { id: 'ebay_global', name: 'eBay Global', cat: 'general', tagClass: 'tag-general', icon: '🛍️', url: (q) => `https://www.ebay.com/sch/i.html?_nkw=${q}`, desc: 'Globalna ponuda i dražbe' },
            { id: 'amazon', name: 'Amazon Store', cat: 'general', tagClass: 'tag-general', icon: '📦', url: (q) => `https://www.amazon.com/s?k=${q}`, desc: 'Novi i ponovno prodavani artikli' },
            { id: 'vinted', name: 'Vinted Marketplace', cat: 'general', tagClass: 'tag-general', icon: '👗', url: (q) => `https://www.vinted.com/catalog?search_text=${q}`, desc: 'Moda, obuća i dodaci' },
            
            // Tech Platforms
            { id: 'backmarket', name: 'BackMarket Tech', cat: 'tech', tagClass: 'tag-tech', icon: '📱', url: (q) => `https://www.backmarket.com/en-us/search?q=${q}`, desc: 'Refurbished elektronika' },
            { id: 'swappa', name: 'Swappa Market', cat: 'tech', tagClass: 'tag-tech', icon: '💻', url: (q) => `https://swappa.com/search?q=${q}`, desc: 'Rabljena verified tehnika' }
        ];

        let currentCategory = 'all';

        function filterCategory(cat, element) {
            currentCategory = cat;
            document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
            element.classList.add('active');
            runAllEngine();
        }

        function runAllEngine() {
            const query = document.getElementById('allSearchInput').value.trim();
            const grid = document.getElementById('resultsGrid');
            const countEl = document.getElementById('resultsCount');

            if (!query) {
                grid.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: var(--text-muted);">Unesite pojam za pretraživanje.</p>';
                return;
            }

            const encoded = encodeURIComponent(query);
            const filtered = combinedPlatforms.filter(p => currentCategory === 'all' || p.cat === currentCategory);

            grid.innerHTML = '';
            countEl.innerText = `Prikazano ${filtered.length} izvoza za "${query}"`;

            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = 'card-item';
                card.innerHTML = `
                    <div>
                        <span class="platform-tag ${p.tagClass}">${p.icon} ${p.name}</span>
                        <div style="font-size: 16px; font-weight: 700; margin-bottom: 5px;">${query}</div>
                        <div style="font-size: 13px; color: var(--text-muted);">${p.desc}</div>
                    </div>
                    <a href="${p.url(encoded)}" target="_blank" class="btn-card">Otvori na ${p.name} →</a>
                `;
                grid.appendChild(card);
            });
        }

        function openAllTabs() {
            const query = document.getElementById('allSearchInput').value.trim();
            if (!query) return alert('Unesite pojam.');
            const encoded = encodeURIComponent(query);
            const filtered = combinedPlatforms.filter(p => currentCategory === 'all' || p.cat === currentCategory);
            filtered.forEach(p => window.open(p.url(encoded), '_blank'));
        }

        function runAIAnalysis() {
            const query = document.getElementById('allSearchInput').value.trim();
            if (!query) return alert('Unesite pojam.');
            const prompt = `Izradi procjenu preprodajne vrijednosti, marže i stanja na tržištu za: ${query}`;
            window.open(`https://chatgpt.com/?q=${encodeURIComponent(prompt)}`, '_blank');
        }

        // Automatsko preuzimanje pretrage iz HUB-a ili postavljanje zadane vrijednosti
        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const searchQuery = urlParams.get('search');
            if (searchQuery) {
                document.getElementById('allSearchInput').value = searchQuery;
            }
            runAllEngine();
        };
    </script>
</body>
</html>
